# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/dentalpro"

# NextAuth session signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Public site URL, used for metadata/canonical/sitemap generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed script (prisma/seed.ts) — required to create the initial admin user.
# No insecure default is provided; the seed fails if ADMIN_PASSWORD is missing or short.
ADMIN_EMAIL="admin@dentalpro.com"
ADMIN_PASSWORD="set-a-strong-password-at-least-8-characters"
